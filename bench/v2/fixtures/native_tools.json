  "type": "function",
  "function": {
   "name": "add_schedule",
   "description": "Add a scheduled note PATHFINDER says at a time, once or on a repeat (not a Reminders item).",
   "parameters": {
    "type": "object",
    "properties": {
     "at": {
      "type": "string",
      "format": "local_datetime",
      "description": "local time, YYYY-MM-DD HH:MM, no offset"
     },
     "text": {
      "type": "string",
      "description": "what to say when it fires"
     },
     "repeat": {
      "type": "string",
      "description": "none|daily|weekly"
     }
    },
    "required": [
     "at",
     "text"
    ]
   }
  }
 },
