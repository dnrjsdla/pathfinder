     "end"
    ]
   }
  }
 },
 {
  "type": "function",
  "function": {
   "name": "search_tools",
   "description": "Search the public MCP registry for servers by name and description (the user asks what tools exist for X). The registry is in English: search English words for what the tool does or is called.",
   "parameters": {
    "type": "object",
    "properties": {
     "query": {
      "type": "string",
      "description": "English words for what the tool does or is called (names and descriptions are searched): gmail, brave search, weather"
     }
    },
    "required": [
     "query"
    ]
   }
  }
 },
 {
  "type": "function",
  "function": {
   "name": "propose_install",
   "description": "Check and propose installing an MCP server by name (as search_tools or the registry shows it) - runs the checks and queues one approval; tell the user what it found.",
   "parameters": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string",
      "description": "the server name"
     }
    },
    "required": [
     "name"
    ]
   }
  }
 },
 {
  "type": "function",
  "function": {
   "name": "list_mail",
   "description": "List recent mail headers.",
   "parameters": {
    "type": "object",
    "properties": {
     "limit": {
      "type": "integer",
      "description": "how many, 1-20, most recent first"
     }
    },
    "required": [
     "limit"
    ]
   }
  }
 },
 {
  "type": "function",
  "function": {
   "name": "search_mail",
   "description": "Search mail; newest matching headers first. On Gmail the query takes Gmail's search syntax: from:, subject:, after:2026/09/01, newer_than:7d, plain words.",
   "parameters": {
    "type": "object",
    "properties": {
     "query": {
      "type": "string",
      "description": "the search, at most 200 characters"
     },
     "limit": {
      "type": "integer",
      "description": "how many, 1-20 (default 10)"
     }
    },
    "required": [
     "query"
    ]
   }
  }
 },
 {
  "type": "function",
  "function": {
   "name": "read_mail",
   "description": "Read one mail's full body by its id.",
   "parameters": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "description": "the id from list_mail or search_mail"
     }
    },
    "required": [
     "id"
    ]
   }
  }
 },
